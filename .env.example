DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Receipt OCR and AI (server-only)
ZAI_API_KEY=
OPENAI_API_KEY=

# Shared receipt admission (server-only; 0 disables new extractions)
RECEIPT_GLOBAL_DAILY_LIMIT=100
RECEIPT_GLOBAL_CONCURRENCY=3
# Optional stable HMAC secret (32+ characters); defaults to BETTER_AUTH_SECRET.
SECURITY_LIMITER_SECRET=

# Optional server timing logs in production (development logs automatically).
# Logs stage durations only; no credentials or ledger contents.
LEDGER_PERFORMANCE_LOGS=0
